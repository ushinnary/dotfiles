theme = dark:GitHub Dark,light:GitHub
font-family = Google Sans Code
font-size = 12

command = nu

window-padding-x = 14
window-padding-y = 10
window-padding-balance = true

cursor-style = block
cursor-style-blink = true

# Only the background is translucent (niri blurs behind it); text stays opaque.
background-opacity = 0.85
background-opacity-cells = true
background-blur = true

custom-shader = ~/.config/ghostty/shaders/smear_cursor_block.glsl
