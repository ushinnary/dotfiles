layout {
    // Matches DMS frameThickness (8) so screen edges and window gaps line up.
    gaps 8
    center-focused-column "never"
    // A lone window sits centred instead of glued to the left edge.
    always-center-single-column
    // Transparent so the wallpaper shows through (stationary behind workspaces).
    background-color "transparent"
    default-column-width {
        proportion 0.5
    }
    focus-ring {
        off
        width 0
    }
    // Large, soft, slightly dropped shadow (macOS-style depth); the focused
    // window gets a darker one so it reads as lifted. Overrides the shadow
    // colour from dms/colors.kdl, which is included earlier.
    shadow {
        on
        softness 40
        spread 2
        offset x=0 y=10
        draw-behind-window true
        color "#00000070"
        inactive-color "#00000030"
    }
    border {
        on
        width 0.5
        active-color "#FFFFFF50"
        inactive-color "#FFFFFF15"
        urgent-color "#eb6f92"
    }
}

