prefer-no-csd
overview {
    zoom 0.5
    // Keep the backdrop dark when no layer-rule covers it.
    backdrop-color "#1e1e2e"
    workspace-shadow {
        off
    }
}
hotkey-overlay {
    skip-at-startup
}
gestures {
    hot-corners {
        top-left
    }
}
// Cursor: dms/cursor.kdl (DMS settings) for niri, home.pointerCursor in
// nix/modules/desktop/desktop-environment.nix for apps — keep them equal.
workspace "Browser"
workspace "Code"
workspace "Chat"
workspace "Media"
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    // macOS-like: a subtle grow + fade on open (niri's default grows from
    // 50%), and a quicker, smaller shrink + fade on close.
    window-open {
        duration-ms 200
        curve "ease-out-cubic"
        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float scale = mix(0.94, 1.0, p);
                vec3 coords = vec3((coords_geo.xy - vec2(0.5)) / scale + vec2(0.5), 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords;
                return texture2D(niri_tex, coords_tex.st) * p;
            }
        "
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float scale = mix(1.0, 0.96, p);
                vec3 coords = vec3((coords_geo.xy - vec2(0.5)) / scale + vec2(0.5), 1.0);
                vec3 coords_tex = niri_geo_to_tex * coords;
                return texture2D(niri_tex, coords_tex.st) * (1.0 - p);
            }
        "
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    exit-confirmation-open-close {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    screenshot-ui-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
}

