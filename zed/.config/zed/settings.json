{
  "cli_default_open_behavior": "new_window",
  "use_podman": true,
  "agent_ui_font_size": 14.0,
  "ui_font_size": 16.0,
  "buffer_font_size": 13.0,
  "minimum_split_diff_width": 0.0,
  "agent_servers": {
    "OpenCode": {
      "favorite_config_option_values": {
        "model": [
          "opencode/deepseek-v4-flash-free"
        ]
      },
      "type": "custom",
      "command": "/run/current-system/sw/bin/opencode",
      "args": ["acp"],
    },
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": false,
    },
  },
  "project_panel": {
    "git_status_indicator": true,
    "diagnostic_badges": false,
    "dock": "right",
  },
  "title_bar": {
    "show_branch_status_icon": true,
  },
  "allow_rewrap": "anywhere",
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
  },
  "gutter": {
    "min_line_number_digits": 12,
  },
  "auto_update": false,
  "sticky_scroll": {
    "enabled": true,
  },
  "diff_view_style": "unified",
  "show_edit_predictions": true,
  "edit_predictions": {
    "mode": "eager",
    "provider": "none",
  },
  "agent": {
    "auto_compact": {
      "threshold": "80%"
    },
    "cancel_generation_on_terminal_stop": false,
    "expand_terminal_card": false,
    "expand_edit_card": false,
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "network_hosts": [
        "registry.npmjs.org"
      ]
    },
    "play_sound_when_agent_done": "when_hidden",
    "dock": "left",
    "use_modifier_to_send": true,
    "notify_when_agent_waiting": "never",
    "enable_feedback": false,
    "default_profile": "write",
    "tool_permissions": {
      "tools": {
        "write_file": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^npx\\s+biome(\\s|$)"
            },
            {
              "pattern": "^npx\\s+vitest(\\s|$)"
            },
            {
              "pattern": "^npx\\s+vue-tsc(\\s|$)"
            },
            {
              "pattern": "^npx\\s+playwright(\\s|$)"
            },
            {
              "pattern": "^cargo\\s+check(\\s|$)"
            },
            {
              "pattern": "^cargo\\s+test(\\s|$)"
            },
            {
              "pattern": "^rustfmt\\b"
            },
            {
              "pattern": "^sed\\b"
            },
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^npm\\s+run(\\s|$)"
            },
            {
              "pattern": "^cargo\\s+fmt(\\s|$)"
            },
            {
              "pattern": "^cargo\\s+run(\\s|$)"
            }
          ]
        },
        "skill": {
          "default": "allow"
        },
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://github\\.com",
            },
            {
              "pattern": "^https?://search\\.nixos\\.org",
            },
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com",
            },
            {
              "pattern": "^https?://nixos\\.org",
            },
            {
              "pattern": "^https?://zed\\.dev",
            },
            {
              "pattern": "^https?://api\\.github\\.com",
            },
            {
              "pattern": "^https?://danklinux\\.com",
            },
            {
              "pattern": "^https?://status\\.nixos\\.org",
            },
          ],
        },
      },
    },
    "default_model": {
      "effort": "max",
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna",
      "enable_thinking": true,
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "gpt-5-mini",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.6",
        "enable_thinking": true
      },
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-4.6",
        "enable_thinking": true
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5.3-codex",
        "enable_thinking": true
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-luna",
        "enable_thinking": true,
        "effort": "max"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-terra",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": [],
  },
  "git_panel": {
    "group_by": "staging",
    "dock": "left",
    "file_icons": true,
    "tree_view": true,
  },
  "vim_mode": true,
  "ui_font_weight": 300.0,
  "ui_font_family": "Nunito",
  "buffer_font_family": "Comic Mono",
  "theme": {
    "mode": "system",
    "light": "GitHub Light",
    "dark": "GitHub Dark",
  },
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "load_direnv": "shell_hook",
  "terminal": {
    "env": {
      "DIRENV_ENABLED": "1",
    },
  },
  "languages": {
    "Nix": {
      "language_servers": ["nil"],
    },
    "Lua": {
      "language_servers": ["lua-language-server"],
    },
    "Nu": {
      "language_servers": ["nushell"],
      "formatter": {
        "external": {
          "command": "nufmt",
          "arguments": ["--stdin"],
        },
      },
    },
    "Kdl": {
      "formatter": {
        "external": {
          "command": "kdlfmt",
          "arguments": ["format", "-", "--kdl-version", "v1"],
        },
      },
      "format_on_save": "on",
    },
    "TypeScript": {
      "language_servers": [
        "tsgo",
        "!vtsls",
        "!typescript-language-server",
        "...",
      ],
    },
    "TSX": {
      "language_servers": [
        "tsgo",
        "!vtsls",
        "!typescript-language-server",
        "...",
      ],
    },
  },
  "lsp": {
    "rust-analyzer": {
      "binary": {
        "arguments": [],
      },
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
      },
    },
  },
  "auto_install_extensions": {
    "html": true,
    "nix": true,
    "nu": true,
    "rust": true,
    "surrealql": true,
    "toml": true,
    "biome": true,
    "github-theme": true,
    "catppuccin-icons": true,
    "csharp": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "emmet": true,
    "ini": true,
    "lua": true,
    "powershell": true,
    "scss": true,
    "sql": true,
    "svelte": true,
    "vue": true,
    "xml": true,
    "kdl": true,
    "tsgo": true,
  },
}
